{
    "configurations": [
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/lab02/imgui",
                "${workspaceFolder}/lab02/imgui/backends",
                "/opt/homebrew/include",
                "/opt/homebrew/opt/openssl@3/include"
            ],
            "defines": [
                "CPPHTTPLIB_OPENSSL_SUPPORT"
            ],
            "macFrameworkPath": [
                "/Library/Frameworks",
                "/System/Library/Frameworks"
            ],
            "compilerPath": "/usr/bin/clang++",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-arm64"
        }
    ],
    "version": 4
}